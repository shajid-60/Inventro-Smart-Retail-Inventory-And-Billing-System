<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shajid.app.inventro.controller.DashboardController"
            style="-fx-background-color: linear-gradient(from 25% 25% to 100% 100%, #081822, #0f3a4e);">

    <top>
        <HBox spacing="10"
              style="-fx-padding: 20; -fx-background-color: radial-gradient(center 50% 10%, radius 90%, #00ffee33, transparent 80%);">
            <Label text="Inventro" textFill="#00f2ea">
                <font>
                    <Font name="System Bold" size="26"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Admin Dashboard" textFill="white">
                <font>
                    <Font size="20"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="18"
              style="-fx-padding: 20; -fx-background-color: radial-gradient(center 50% 10%, radius 90%, #00ffee33, transparent 80%);">

            <!-- Summary cards row -->
            <HBox spacing="18">
                <VBox spacing="4"
                      style="-fx-background-color: rgba(17,34,51,0.85); -fx-background-radius: 16; -fx-padding: 16;"
                      HBox.hgrow="ALWAYS">
                    <Label text="Total Products" textFill="#88ffffff">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Label>
                    <Label fx:id="totalProductsLabel" text="0" textFill="#00f2ea">
                        <font>
                            <Font name="System Bold" size="26"/>
                        </font>
                    </Label>
                </VBox>

                <VBox spacing="4"
                      style="-fx-background-color: rgba(17,34,51,0.85); -fx-background-radius: 16; -fx-padding: 16;"
                      HBox.hgrow="ALWAYS">
                    <Label text="Low Stock (1-5)" textFill="#88ffffff">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Label>
                    <Label fx:id="lowStockLabel" text="0" textFill="#FFC300">
                        <font>
                            <Font name="System Bold" size="26"/>
                        </font>
                    </Label>
                </VBox>

                <VBox spacing="4"
                      style="-fx-background-color: rgba(17,34,51,0.85); -fx-background-radius: 16; -fx-padding: 16;"
                      HBox.hgrow="ALWAYS">
                    <Label text="Out of Stock" textFill="#88ffffff">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Label>
                    <Label fx:id="outOfStockLabel" text="0" textFill="#C70039">
                        <font>
                            <Font name="System Bold" size="26"/>
                        </font>
                    </Label>
                </VBox>

                <VBox spacing="4"
                      style="-fx-background-color: rgba(17,34,51,0.85); -fx-background-radius: 16; -fx-padding: 16;"
                      HBox.hgrow="ALWAYS">
                    <Label text="Total Stock Value" textFill="#88ffffff">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Label>
                    <Label fx:id="stockValueLabel" text="0.00" textFill="#00f2ea">
                        <font>
                            <Font name="System Bold" size="22"/>
                        </font>
                    </Label>
                </VBox>
                <VBox spacing="4"
                      style="-fx-background-color: rgba(17,34,51,0.85); -fx-background-radius: 16; -fx-padding: 16;"
                      HBox.hgrow="ALWAYS">
                    <Label text="Total Revenue" textFill="#88ffffff">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Label>
                    <Label fx:id="revenueLabel" text="0.00" textFill="#00f2ea">
                        <font>
                            <Font name="System Bold" size="22"/>
                        </font>
                    </Label>
                </VBox>

            </HBox>

            <!-- Actions row -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Manage Products"
                        onAction="#onManageProducts"
                        style="-fx-background-color: linear-gradient(to right,#00f2ea,#00c4c4);
                               -fx-background-radius: 12;
                               -fx-font-size: 14;
                               -fx-font-weight:bold;
                               -fx-text-fill:white;"
                        prefHeight="40"
                        prefWidth="180"/>

                <Button text="View Customers"
                        onAction="#onViewCustomers"
                        style="-fx-background-color: transparent;
                               -fx-border-color:#00f2ea;
                               -fx-border-radius:12;
                               -fx-border-width:2;
                               -fx-text-fill:#00f2ea;
                               -fx-font-weight:bold;"
                        prefHeight="40"
                        prefWidth="160"/>
            </HBox>

            <!-- Chart area -->
            <BorderPane style="-fx-background-color: rgba(17,34,51,0.85); -fx-background-radius: 16; -fx-padding: 16;"
                        VBox.vgrow="ALWAYS">
                <top>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Stock by Product (Top 10)" textFill="white">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                    </HBox>
                </top>

                <center>
                    <BarChart fx:id="stockChart"
                              animated="true"
                              legendVisible="false"
                              style="-fx-padding:10;">
                        <xAxis>
                            <CategoryAxis label="Product"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Stock"/>
                        </yAxis>
                    </BarChart>
                </center>
            </BorderPane>

        </VBox>
    </center>

</BorderPane>
