<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shajid.app.inventro.controller.CustomerDashboardController"
            style="-fx-background-color: linear-gradient(from 25% 25% to 100% 100%, #081822, #0f3a4e);">

    <top>
        <HBox spacing="10"
              style="-fx-padding: 20; -fx-background-color: radial-gradient(center 50% 10%, radius 90%, #00ffee33, transparent 80%);">
            <Label text="Inventro" textFill="#00f2ea">
                <font><Font name="System Bold" size="26"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Customer Dashboard" textFill="white">
                <font><Font size="20"/></font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="18"
              style="-fx-padding: 20; -fx-background-color: radial-gradient(center 50% 10%, radius 90%, #00ffee33, transparent 80%);">

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Logout"
                        onAction="#onLogout"
                        style="-fx-background-color: transparent;
                               -fx-border-color:#00f2ea;
                               -fx-border-radius:12;
                               -fx-border-width:2;
                               -fx-text-fill:#00f2ea;
                               -fx-font-weight:bold;"/>
            </HBox>

            <TableView fx:id="productsTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color:#FFFFFF; -fx-background-radius:8; -fx-border-radius:8;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colName" text="Name" prefWidth="240"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="200"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="120"/>
                    <TableColumn fx:id="colSoldPrice" text="Price" prefWidth="120"/>
                    <!-- add\-to\-cart button column -->
                    <TableColumn fx:id="colAction" text="Action" prefWidth="140"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Cart Total:" textFill="white">
                    <font><Font size="16"/></font>
                </Label>
                <Label fx:id="cartTotalLabel"
                       text="0.00"
                       textFill="#00f2ea">
                    <font><Font name="System Bold" size="18"/></font>
                </Label>

                <Button text="Go to Billing"
                        onAction="#onGoToBilling"
                        style="-fx-background-color: linear-gradient(to right,#00f2ea,#00c4c4);
                               -fx-background-radius: 12;
                               -fx-font-size: 14;
                               -fx-font-weight:bold;
                               -fx-text-fill:white;"
                        prefHeight="40"
                        prefWidth="160"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
