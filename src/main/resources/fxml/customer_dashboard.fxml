<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shajid.app.inventro.controller.CustomerDashboardController"
            style="-fx-background-color: linear-gradient(from 25% 25% to 100% 100%, #081822, #0f3a4e);">
    <top>
        <HBox spacing="10"
              style="-fx-padding: 20; -fx-background-color: radial-gradient(center 50% 10%, radius 90%, #00ffee33, transparent 80%);">
            <Label text="Inventro" textFill="#00f2ea">
                <font><Font name="System Bold" size="26"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Customer Dashboard" textFill="white">
                <font><Font size="20"/></font>
            </Label>
        </HBox>
    </top>
    <center>
        <VBox spacing="18"
              style="-fx-padding: 20; -fx-background-color: radial-gradient(center 50% 10%, radius 90%, #00ffee33, transparent 80%);">
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Logout"
                        onAction="#onLogout"
                        style="-fx-background-color: transparent;
                               -fx-border-color:#00f2ea;
                               -fx-border-radius:12;
                               -fx-border-width:2;
                               -fx-text-fill:#00f2ea;
                               -fx-font-weight:bold;"/>
            </HBox>
            <ScrollPane fx:id="productScrollPane"
                        VBox.vgrow="ALWAYS"
                        fitToWidth="true"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <content>
                    <FlowPane fx:id="productsContainer"
                              hgap="20"
                              vgap="20"
                              style="-fx-background-color: transparent;">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
            <HBox spacing="18" alignment="CENTER_RIGHT"
                  style="-fx-background-color: rgba(17,34,51,0.85);
                         -fx-background-radius: 16;
                         -fx-padding: 16;">
                <Label text="Cart Total:" textFill="white">
                    <font><Font size="18"/></font>
                </Label>
                <Label fx:id="cartTotalLabel"
                       text="৳0.00"
                       textFill="#00f2ea">
                    <font><Font name="System Bold" size="22"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Checkout"
                        onAction="#onGoToBilling"
                        style="-fx-background-color: linear-gradient(to right,#00f2ea,#00c4c4);
                               -fx-background-radius: 12;
                               -fx-font-size: 16;
                               -fx-font-weight:bold;
                               -fx-text-fill:white;"
                        prefHeight="44"
                        prefWidth="180"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>